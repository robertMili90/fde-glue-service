{
  "info": {
    "name": "FDE Stripe to ERP - localhost demo",
    "description": "Import with localhost.postman_environment.json. Start apps using README. Run folder 01 for the ERP-only demo, or folder 02 manually for real sandbox integration. Run folders separately; the whole collection includes mutually exclusive fault controls and a guarded ERP reset. No Stripe API key is stored or required by Postman. See postman/README.md for the demo walkthrough.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
