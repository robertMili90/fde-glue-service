    {
      "name": "01 - ERP demo - no Stripe required",
      "description": "Run this folder in order. Direct ERP contract demonstration; does not establish Stripe synchronization. Fresh synthetic invoice/payment IDs per run. Prefer a separate ERP database with glue stopped: reconciliation otherwise discovers these synthetic references. Does not reset existing invoices. Clears active simulator faults.",
      "item": [
        {
          "name": "01 - Clear simulator faults",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{erpBaseUrl}}/demo/faults",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"NONE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create fresh UNPAID invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{erpBaseUrl}}/invoices",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{demoInvoiceId}}\",\n  \"paymentIntentId\": \"{{demoPaymentIntentId}}\",\n  \"expectedAmountMinor\": {{amountMinor}},\n  \"currency\": \"{{currency}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
                  "pm.collectionVariables.set('demoInvoiceId', 'inv_postman_' + suffix);",
                  "pm.collectionVariables.set('demoPaymentIntentId', 'pi_postman_' + suffix);",
                  "pm.collectionVariables.set('demoPaidKey', 'postman_paid_' + suffix);",
                  "pm.collectionVariables.set('demoRefundKey', 'postman_refund_' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Invoice is UNPAID\", () => pm.expect(pm.response.json().financialStatus).to.eql(\"UNPAID\"));",
                  "pm.collectionVariables.set(\"demoEtag\", pm.response.headers.get(\"ETag\"));",
                  "pm.collectionVariables.set(\"demoInitialEtag\", pm.response.headers.get(\"ETag\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Read invoice and ETag",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Invoice is UNPAID\", () => pm.expect(pm.response.json().financialStatus).to.eql(\"UNPAID\"));",
                  "pm.collectionVariables.set(\"demoEtag\", pm.response.headers.get(\"ETag\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Apply PAID projection",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demoPaidKey}}"
              },
              {
                "key": "If-Match",
                "value": "{{demoEtag}}"
              }
            ],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}/payment-projection",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"{{demoPaymentIntentId}}\",\n  \"currency\": \"{{currency}}\",\n  \"amountCollectedMinor\": {{amountMinor}},\n  \"amountRefundedMinor\": 0,\n  \"status\": \"PAID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Invoice is PAID\", () => pm.expect(pm.response.json().financialStatus).to.eql(\"PAID\"));",
                  "pm.collectionVariables.set(\"demoEtag\", pm.response.headers.get(\"ETag\"));",
                  "pm.collectionVariables.set(\"demoPaidVersion\", String(pm.response.json().version));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Replay same key with original ETag",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demoPaidKey}}"
              },
              {
                "key": "If-Match",
                "value": "{{demoInitialEtag}}"
              }
            ],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}/payment-projection",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"{{demoPaymentIntentId}}\",\n  \"currency\": \"{{currency}}\",\n  \"amountCollectedMinor\": {{amountMinor}},\n  \"amountRefundedMinor\": 0,\n  \"status\": \"PAID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Invoice is PAID\", () => pm.expect(pm.response.json().financialStatus).to.eql(\"PAID\"));",
                  "pm.test('Replay keeps the committed version', () => pm.expect(String(pm.response.json().version)).to.eql(pm.collectionVariables.get('demoPaidVersion')));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Changed payload with same key is rejected",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demoPaidKey}}"
              },
              {
                "key": "If-Match",
                "value": "{{demoEtag}}"
              }
            ],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}/payment-projection",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"{{demoPaymentIntentId}}\",\n  \"currency\": \"{{currency}}\",\n  \"amountCollectedMinor\": {{amountMinor}},\n  \"amountRefundedMinor\": {{amountMinor}},\n  \"status\": \"REFUNDED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Payload conflict\", () => pm.expect(pm.response.json().reasonCode).to.eql(\"IDEMPOTENCY_PAYLOAD_CONFLICT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Stale version with fresh key is rejected",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demoPaidKey}}_stale"
              },
              {
                "key": "If-Match",
                "value": "{{demoInitialEtag}}"
              }
            ],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}/payment-projection",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"{{demoPaymentIntentId}}\",\n  \"currency\": \"{{currency}}\",\n  \"amountCollectedMinor\": {{amountMinor}},\n  \"amountRefundedMinor\": 0,\n  \"status\": \"PAID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 412\", () => pm.response.to.have.status(412));",
                  "pm.test(\"Stale version\", () => pm.expect(pm.response.json().reasonCode).to.eql(\"STALE_INVOICE_VERSION\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Amount mismatch is held",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demoPaidKey}}_mismatch"
              },
              {
                "key": "If-Match",
                "value": "{{demoEtag}}"
              }
            ],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}/payment-projection",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"{{demoPaymentIntentId}}\",\n  \"currency\": \"{{currency}}\",\n  \"amountCollectedMinor\": {{mismatchedAmountMinor}},\n  \"amountRefundedMinor\": 0,\n  \"status\": \"PAID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Financial conflict\", () => pm.expect(pm.response.json().reasonCode).to.eql(\"FINANCIAL_CONFLICT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Apply full REFUNDED projection",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demoRefundKey}}"
              },
              {
                "key": "If-Match",
                "value": "{{demoEtag}}"
              }
            ],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}/payment-projection",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"{{demoPaymentIntentId}}\",\n  \"currency\": \"{{currency}}\",\n  \"amountCollectedMinor\": {{amountMinor}},\n  \"amountRefundedMinor\": {{amountMinor}},\n  \"status\": \"REFUNDED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Invoice is REFUNDED\", () => pm.expect(pm.response.json().financialStatus).to.eql(\"REFUNDED\"));",
                  "pm.collectionVariables.set(\"demoEtag\", pm.response.headers.get(\"ETag\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 - Verify final invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{erpBaseUrl}}/invoices/{{demoInvoiceId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Invoice is REFUNDED\", () => pm.expect(pm.response.json().financialStatus).to.eql(\"REFUNDED\"));",
                  "pm.test('Full refund preserves collected amount', () => {",
                  "    const projection = pm.response.json().paymentProjection;",
                  "    pm.expect(projection.amountCollectedMinor).to.eql(Number(pm.variables.get('amountMinor')));",
                  "    pm.expect(projection.amountRefundedMinor).to.eql(projection.amountCollectedMinor);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Inspect ERP counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{erpBaseUrl}}/demo/state",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"At least one projection exists\", () => pm.expect(pm.response.json().paymentProjectionCount).to.be.at.least(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Glue integration - Stripe sandbox required",
      "description": "Run selected requests manually after the README sandbox setup. Requires real sandbox resource, glue test key and matching webhook secret. All collection URLs are localhost; the worker reads Stripe. The existing fixture script creates/links/confirms a sandbox payment; use its invoice and PaymentIntent IDs below. Do not run ERP demo with a fake payment to prove integration. Webhook receipt is asynchronous; inspect work and invoice later. These requests never create payments/refunds in Stripe.",
      "item": [
        {
          "name": "01 - Inspect linked sandbox invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{erpBaseUrl}}/invoices/by-payment/{{stripePaymentIntentId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"stripeInvoiceId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Send new signed payment notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{glueBaseUrl}}/webhooks/stripe",
            "description": "Creates a fresh event ID. Reads authoritative current facts through Stripe; the supplied event does not force a PAID result.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{stripeEventId}}\",\n  \"object\": \"event\",\n  \"type\": \"payment_intent.succeeded\",\n  \"livemode\": false,\n  \"data\": {\n    \"object\": {\n      \"id\": \"{{stripePaymentIntentId}}\",\n      \"object\": \"payment_intent\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('stripeEventId', 'evt_postman_' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, ''));",
                  "const stripeCrypto = require('crypto-js');",
                  "const secret = pm.environment.get('stripeWebhookSecret');",
                  "if (!secret || !secret.startsWith('whsec_')) {",
                  "    throw new Error('Set stripeWebhookSecret locally to the glue STRIPE_WEBHOOK_SECRET.');",
                  "}",
                  "const paymentIntentId = pm.variables.get('stripePaymentIntentId');",
                  "if (!paymentIntentId || paymentIntentId.includes('REPLACE')) {",
                  "    throw new Error('Set stripePaymentIntentId to an existing sandbox PaymentIntent.');",
                  "}",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const rawBody = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.request.body.update(rawBody);",
                  "const signature = stripeCrypto.HmacSHA256(timestamp + '.' + rawBody, secret).toString(stripeCrypto.enc.Hex);",
                  "pm.request.headers.upsert({key: 'Stripe-Signature', value: 't=' + timestamp + ',v1=' + signature});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Receipt recorded\", () => pm.expect(pm.response.json().status).to.eql(\"recorded\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Resend same event - duplicate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{glueBaseUrl}}/webhooks/stripe",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{stripeEventId}}\",\n  \"object\": \"event\",\n  \"type\": \"payment_intent.succeeded\",\n  \"livemode\": false,\n  \"data\": {\n    \"object\": {\n      \"id\": \"{{stripePaymentIntentId}}\",\n      \"object\": \"payment_intent\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('stripeEventId')) { throw new Error('Send a new notification first.'); }",
                  "const stripeCrypto = require('crypto-js');",
                  "const secret = pm.environment.get('stripeWebhookSecret');",
                  "if (!secret || !secret.startsWith('whsec_')) {",
                  "    throw new Error('Set stripeWebhookSecret locally to the glue STRIPE_WEBHOOK_SECRET.');",
                  "}",
                  "const paymentIntentId = pm.variables.get('stripePaymentIntentId');",
                  "if (!paymentIntentId || paymentIntentId.includes('REPLACE')) {",
                  "    throw new Error('Set stripePaymentIntentId to an existing sandbox PaymentIntent.');",
                  "}",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const rawBody = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.request.body.update(rawBody);",
                  "const signature = stripeCrypto.HmacSHA256(timestamp + '.' + rawBody, secret).toString(stripeCrypto.enc.Hex);",
                  "pm.request.headers.upsert({key: 'Stripe-Signature', value: 't=' + timestamp + ',v1=' + signature});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Duplicate receipt\", () => pm.expect(pm.response.json().status).to.eql(\"duplicate\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Inspect payment work",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{glueBaseUrl}}/operations/work/{{stripePaymentIntentId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
