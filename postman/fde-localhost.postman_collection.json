    {
      "name": "04 - Manual failure controls and reset",
      "description": "Run requests individually. Faults affect unseen ERP projection keys. Configure before a new sandbox payment/refund changes current facts; already-correct observations may be no-ops. Reset deletes only ERP simulator data. Never run this folder as one demo.",
      "item": [
        {
          "name": "Fail next two writes before commit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
