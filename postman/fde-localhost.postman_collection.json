        {
          "name": "09 - Old success notification after refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{glueBaseUrl}}/webhooks/stripe",
            "description": "First create a full successful refund using the existing sandbox fixture tool. A new payment-success notification still leads the worker to current refund facts. Then repeat requests 04 and 06; expect REFUNDED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{stripeEventId}}\",\n  \"object\": \"event\",\n  \"type\": \"payment_intent.succeeded\",\n  \"livemode\": false,\n  \"data\": {\n    \"object\": {\n      \"id\": \"{{stripePaymentIntentId}}\",\n      \"object\": \"payment_intent\"\n    }\n  },\n  \"created\": 1600000000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('stripeEventId', 'evt_postman_' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, ''));",
                  "const stripeCrypto = require('crypto-js');",
                  "const secret = pm.environment.get('stripeWebhookSecret');",
                  "if (!secret || !secret.startsWith('whsec_')) {",
                  "    throw new Error('Set stripeWebhookSecret locally to the glue STRIPE_WEBHOOK_SECRET.');",
                  "}",
                  "const paymentIntentId = pm.variables.get('stripePaymentIntentId');",
                  "if (!paymentIntentId || paymentIntentId.includes('REPLACE')) {",
                  "    throw new Error('Set stripePaymentIntentId to an existing sandbox PaymentIntent.');",
                  "}",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const rawBody = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.request.body.update(rawBody);",
                  "const signature = stripeCrypto.HmacSHA256(timestamp + '.' + rawBody, secret).toString(stripeCrypto.enc.Hex);",
                  "pm.request.headers.upsert({key: 'Stripe-Signature', value: 't=' + timestamp + ',v1=' + signature});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Receipt recorded\", () => pm.expect(pm.response.json().status).to.eql(\"recorded\"));"
                ]
              }
            }
          ]
        }
      ]
