# For real Stripe test access, set the sandbox profile and your credentials locally.
SPRING_PROFILES_ACTIVE=demo
STRIPE_SECRET_KEY=sk_test_offline_demo
STRIPE_WEBHOOK_SECRET=whsec_offline_demo
ERP_BASE_URL=http://localhost:8081
GLUE_PORT=8080
ERP_PORT=8081
SYNC_ENABLED=true
